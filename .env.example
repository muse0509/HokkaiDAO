# Canonical site URL, e.g. https://ctsdao.xyz (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Set to "false" to hide the interest form and show the fallback link instead
NEXT_PUBLIC_FORM_ENABLED=true

# Database connection.
#  - postgres://... or postgresql://...  -> PostgreSQL (production)
#  - file:./data/dev.db (or empty)       -> local SQLite
DATABASE_URL=

# Secret for /api/admin/submissions and /admin. Generate with: openssl rand -hex 32
ADMIN_VIEW_SECRET=

# Optional analytics. The site works fine with all of these empty.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Default utm_source recorded when a visitor arrives with no attribution params
NEXT_PUBLIC_DEFAULT_UTM_SOURCE=

# Contact details rendered on the page.
# CONTACT_X_HANDLE is the single source of truth for the project's X account —
# switch to @ctsDAO here once the handle is secured.
CONTACT_EMAIL=hokkai_dao@proton.me
CONTACT_X_HANDLE=@Hokkai_dao

# Shown if the form is disabled (e.g. a Typeform/Tally link)
INTEREST_FORM_FALLBACK_URL=

# Optional salt for hashing submitter IPs (defaults to a built-in constant)
IP_HASH_SALT=
